# ─────────────────────────────────────────────────────────────
# Build Smart website — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# Variables starting with NEXT_PUBLIC_ are visible in the browser;
# everything else stays on the server.
# ─────────────────────────────────────────────────────────────

# Public URL of the live site (used for SEO, sitemap and social previews)
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Business WhatsApp number — international format, digits only, e.g. 9198XXXXXXXX
# Powers the floating WhatsApp button and "Chat on WhatsApp" links.
# Optional: overrides the number set in src/content/site.ts (currently 917708856606).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Show editor hints (yellow "✎" notes and "temp image" tags) on a deployed preview. Never enable on the live site.
NEXT_PUBLIC_SHOW_CONTENT_NOTES=false

# ── Phase 1: lead storage ───────────────────────────────────
# Enquiries go to your Google Sheet once LEAD_WEBHOOK_URL is filled in
# (step-by-step: docs/GOOGLE-SHEETS-SETUP.md). While it's empty, they are saved
# on this computer in data/leads.jsonl instead (open with: npm run leads).
LEAD_WEBHOOK_URL=
# Must match SECRET at the top of the Apps Script (docs/google-sheets/BuildSmart-Enquiries.gs)
LEAD_WEBHOOK_SECRET=
# Optional override: webhook | file | mock (leave empty for automatic)
LEAD_STORAGE=
LEAD_FILE_PATH=data/leads.jsonl
LEAD_RATE_LIMIT_PER_10_MIN=5

# ── Phase 2: WhatsApp notification to the owner (disabled) ──
# none | meta-cloud | webhook
WHATSAPP_NOTIFY_PROVIDER=none
# Owner's WhatsApp number that receives lead alerts (digits only, with country code)
WHATSAPP_OWNER_NUMBER=

# meta-cloud (WhatsApp Business Platform / Cloud API)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
# template (recommended) | text (only works inside a 24-hour customer-service window)
WHATSAPP_MESSAGE_MODE=template
WHATSAPP_TEMPLATE_NAME=new_website_enquiry
WHATSAPP_TEMPLATE_LANG=en

# webhook (Make / Zapier / n8n / Twilio Function / WhatsApp BSP)
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_SECRET=
